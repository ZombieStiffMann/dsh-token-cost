{
  "name": "dsh-token-cost",
  "version": "0.4.0",
  "description": "DeepSeek Harness plugin that estimates the cost of tokens consumed in the current session, pricing every model at its vendor's latest official rates — DeepSeek, Qwen, GLM, Kimi, Doubao, Hunyuan, ERNIE, MiniMax, StepFun, SenseNova, MiMo (CNY) and OpenAI, Anthropic, Google Gemini, xAI, Mistral, Cohere (USD).",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "pricing.js",
    "official-pricing.js",
    "cost-catalog.js",
    "catalog/index.js",
    "catalog/lookup.js",
    "catalog/validate.js",
    "catalog/china/*.js",
    "catalog/world/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test test/fold.test.mjs test/price-parser.test.mjs test/catalog.test.mjs test/lookup.test.mjs && node test/component.test.cjs",
    "test:fold": "node --test test/fold.test.mjs",
    "test:parser": "node --test test/price-parser.test.mjs",
    "test:catalog": "node --test test/catalog.test.mjs test/lookup.test.mjs",
    "test:component": "node test/component.test.cjs",
    "validate:catalog": "node catalog/validate.js"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "token-cost",
    "llm-cost",
    "pricing",
    "qwen",
    "glm",
    "kimi",
    "doubao",
    "hunyuan",
    "plugin"
  ],
  "author": "zombiestiffmann",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zombiestiffmann/dsh-token-cost.git"
  },
  "bugs": {
    "url": "https://github.com/zombiestiffmann/dsh-token-cost/issues"
  },
  "homepage": "https://github.com/zombiestiffmann/dsh-token-cost#readme",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
